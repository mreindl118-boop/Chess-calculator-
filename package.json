{
  "name": "gambitlab",
  "private": true,
  "version": "0.1.0",
  "description": "GambitLab — offline-capable chess & checkers laboratory. Play, analyze and rate games against a scalable engine.",
  "type": "module",
  "scripts": {
    "dev": "npm run engine:copy && vite",
    "build": "npm run engine:copy && tsc -b && vite build",
    "preview": "vite preview",
    "test": "vitest run",
    "test:watch": "vitest",
    "lint": "eslint src tests",
    "format": "prettier --write \"src/**/*.{ts,tsx,css}\" \"tests/**/*.ts\"",
    "format:check": "prettier --check \"src/**/*.{ts,tsx,css}\" \"tests/**/*.ts\"",
    "engine:copy": "node scripts/copy-engine.mjs",
    "icons": "node scripts/gen-icons.mjs",
    "android:sync": "npm run build && cap sync android",
    "android:run": "npm run android:sync && cap run android",
    "android:apk": "npm run android:sync && cd android && ./gradlew assembleRelease"
  },
  "dependencies": {
    "@capacitor/app": "^6.0.0",
    "@capacitor/core": "^6.2.1",
    "@capacitor/haptics": "^6.0.0",
    "@capacitor/status-bar": "^6.0.0",
    "chess.js": "^1.4.0",
    "idb": "^8.0.0",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "zustand": "^5.0.0"
  },
  "devDependencies": {
    "@capacitor/android": "^6.2.1",
    "@capacitor/cli": "^6.2.1",
    "@eslint/js": "^9.39.5",
    "@types/react": "^18.3.0",
    "@types/react-dom": "^18.3.0",
    "@vitejs/plugin-react": "^4.3.0",
    "eslint": "^9.0.0",
    "eslint-plugin-react-hooks": "^5.0.0",
    "fake-indexeddb": "^6.0.0",
    "prettier": "^3.3.0",
    "stockfish": "17.1.0",
    "typescript": "^5.6.0",
    "typescript-eslint": "^8.0.0",
    "vite": "^5.4.0",
    "vite-plugin-pwa": "^0.20.0",
    "vitest": "^2.1.0",
    "workbox-window": "^7.1.0"
  }
}
